FROM node:22.20-bookworm-slim@sha256:b21fe589dfbe5cc39365d0544b9be3f1f33f55f3c86c87a76ff65a02f8f5848e
ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    make \
    python3-pip \
    bash \
    nginx \
&& rm -rf /var/lib/apt/lists/*

RUN addgroup --system www \
 && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
 && mkdir -p /www/.pm2 /var/lib/nginx /var/log/nginx /uploads /config \
      /tmp/nginx/client /tmp/nginx/proxy /tmp/nginx/fastcgi /tmp/nginx/uwsgi /tmp/nginx/scgi \
 && chown -R www:www /www /var/lib/nginx /var/log/nginx /uploads /config /tmp/nginx


RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2@7.0.4

WORKDIR /app

COPY . /app
COPY var/docker/nginx.conf /etc/nginx/nginx.conf

RUN pnpm install --frozen-lockfile
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build
RUN mkdir -p /app/apps/frontend/.next/cache && chown -R www:www /app/apps/frontend/.next/cache

ENV HOME=/www PM2_HOME=/www/.pm2
USER www:www
CMD ["sh", "-c", "nginx && pnpm run pm2"]
