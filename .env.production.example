# Template only. Copy to /etc/putduk/.env.production on a future server.
# Never put real credentials in this file or commit them to GitHub.
PUBLIC_DOMAIN=postiz.example.com

# Replace with an immutable digest for the exact Postiz build that was tested.
POSTIZ_IMAGE=ghcr.io/goldeget/putduk-social-auto@sha256:REPLACE_WITH_VERIFIED_PRIVATE_IMAGE_DIGEST

# Generate independent, long random values out-of-band. For the three database
# and Redis passwords, use URL-safe characters only because they appear in URLs.
POSTIZ_DB_PASSWORD=REPLACE_WITH_UNIQUE_URL_SAFE_SECRET
REDIS_PASSWORD=REPLACE_WITH_DIFFERENT_URL_SAFE_SECRET
TEMPORAL_DB_PASSWORD=REPLACE_WITH_ANOTHER_URL_SAFE_SECRET
JWT_SECRET=REPLACE_WITH_UNIQUE_LONG_RANDOM_SECRET

# Optional. Leave blank until each official developer app has been approved.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_BUSINESS_CLIENT_ID=
TIKTOK_BUSINESS_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
